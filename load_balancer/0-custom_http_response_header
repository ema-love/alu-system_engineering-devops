#!/usr/bin/env bash

# Configure Nginx with a custom X-Served-By response header.

set -e

apt-get update -y
apt-get install -y nginx

cat > /etc/nginx/conf.d/0-custom-http-response-header.conf <<'EOF'
add_header X-Served-By "$hostname" always;
EOF

nginx -t
systemctl enable nginx
systemctl restart nginx
